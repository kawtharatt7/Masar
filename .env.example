# Copy this file to .env.local and fill in real values.

# Server-only. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash (see README note about gemini-1.5-flash).
# Free tier allows only 20 requests/day on gemini-3.8-flash. For development try gemini-3.5-flash-lite (about 500/day).
GEMINI_MODEL=

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Direct link to the intro video. Leave empty to use public/intro.mp4
NEXT_PUBLIC_INTRO_VIDEO_URL=

# Optional. Gemini 3.x thinks by default (slow). 0 = no thinking (default here), a number = token budget,
# "default" = leave the model's own behaviour.
GEMINI_THINKING_BUDGET=

# Optional. false (default) = one Gemini request per analysis (saves quota). true = two parallel requests (faster, uses twice the quota).
GEMINI_SPLIT_ANALYSIS=
